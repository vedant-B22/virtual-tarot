# ==============================================================================
# LIVE TAROT — ENVIRONMENT CONFIGURATION
# Fill in your real credentials below to enable live emails, video, and security.
# ==============================================================================

# Server Port
PORT=5001

# Admin Dashboard Password (change this to your private password)
ADMIN_PASSWORD=tarot2026

# Email Notifications (SMTP / Gmail / Resend / SendGrid)
# If filled, real confirmation emails with live session links will be dispatched.
# If left blank, emails are automatically stored in the Admin Email Previewer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Live Tarot Sanctuary" <noreply@livetarot.com>

# Video Call Provider: "webrtc_p2p" (default built-in, zero keys needed), "daily", or "livekit"
VIDEO_PROVIDER=webrtc_p2p

# Daily.co Configuration (Optional - if using VIDEO_PROVIDER=daily)
# DAILY_API_KEY=
# DAILY_DOMAIN=https://your-domain.daily.co

# LiveKit Configuration (Optional - if using VIDEO_PROVIDER=livekit)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
